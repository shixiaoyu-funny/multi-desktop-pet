{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "桌宠窗口与工具箱窗口的基础权限：核心事件收发（pet:command / pet:state / pet:posture）、窗口控制。",
  "windows": ["pet", "toolbox"],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "core:app:default",
    "core:path:default"
  ]
}
