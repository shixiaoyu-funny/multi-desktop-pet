{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Multi_Pet 权限（主窗口 + 桌面角色窗口）。",
  "windows": ["main", "pet"],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:window:allow-set-position",
