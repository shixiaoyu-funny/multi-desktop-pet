{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Multi_Pet",
  "version": "1.0.0",
  "identifier": "com.local.duo.winpet",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Multi_Pet",
        "create": false,
        "width": 1000,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "center": true,
        "visible": true,
        "decorations": true,
        "shadow": true
      },
      {
        "label": "pet",
        "title": "桌面角色",
        "create": false,
        "url": "pet.html",
        "width": 340,
        "height": 340,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "visible": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
